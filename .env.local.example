# ─────────────────────────────────────────────────────────────────────────
#  doc-ocr-box configuration — single source of truth for BOTH the Next.js
#  frontend and the Python OCR backend.
#
#  Copy to `.env.local` and edit. Both `npm run dev`/`start` and
#  `npm run ocr-api` load this file (via dotenv-cli / a tiny Python loader),
#  so changing a value here is all you need.
# ─────────────────────────────────────────────────────────────────────────

# ── Frontend (Next.js dev/prod server) ──────────────────────────────────
# Deployment mode: development, test, or production.
QTRACX_ENV=development

# Port the Next.js app listens on (npm run dev / npm run start). Default 3002.
# Next.js bind address. Keep loopback for local-only development; use 0.0.0.0
# on the central LAN server so other computers can open the web application.
UI_HOST=127.0.0.1
PORT=3002

# ── Transport shared by the UI and backend ─────────────────────────────
# HTTP is the normal/default mode. When HTTPS is requested, both launchers
# validate the same PEM certificate and unencrypted private key. If either
# file is missing or invalid, both services log a warning and use HTTP.
HTTPS_ENABLED=false
# TLS_CERT_FILE=certificates/qtracx-cert.pem
# TLS_KEY_FILE=certificates/qtracx-key.pem

# ── Browser → backend OCR API ───────────────────────────────────────────
# The URL the BROWSER uses to reach the Python OCR server. Must point at
# OCR_HOST/OCR_PORT below (as reachable from the browser). The browser keeps
# this address but follows the UI's actual http/https protocol, including an
# automatic HTTP fallback. Default localhost:8000.
NEXT_PUBLIC_OCR_API_URL=http://localhost:8000
# Or configure host + port separately (used only when the full URL above is unset):
# NEXT_PUBLIC_OCR_API_HOST=localhost
# NEXT_PUBLIC_OCR_API_PORT=8000

# Remote server that checks extracted values/labels ("Send for Verification").
NEXT_PUBLIC_VERIFY_API_URL=http://localhost:9000/verify

# ── Digital Checksheet template output ──────────────────────────────────
# Backend-only directory where generated <TEMPLATE_ID>.json files are saved.
# Keep this deployment-specific: development and production may point to
# different Digital Checksheet installations.
CHECKSHEET_TEMPLATE_DIR=G:\job related works\HGI Automotives\checksheet_backend\data\templates

# ── Dev-only tools (Auto-Segment + Debug dump) ──────────────────────────
# These are dev conveniences with no env config:
#   • Auto-Segment is disabled for now everywhere (dev and prod).
#   • Debug dump shows only in a dev build; in production the button never
#     renders and no dump is ever produced (no override).

# Browser-side OCR step dumps (adds ?debug_dump=1 to each recognize request).
# Default OFF — set to 1 to enable. The in-app Toolbar toggle (stored in the
# browser's localStorage) overrides this value.
# NEXT_PUBLIC_OCR_DEBUG_DUMP=1

# ── Backend (Python OCR server: npm run ocr-api) ─────────────────────────
# Where uvicorn binds. Use 0.0.0.0 to accept connections from other machines.
OCR_HOST=127.0.0.1
OCR_PORT=8000

# Paddle inference device. The GPU workstation SOP uses gpu:0. Use cpu for an
# intentional CPU deployment, or auto to let Paddle choose its available device.
OCR_DEVICE=gpu:0

# Number of complete, independent Paddle model bundles to load. Each bundle
# consumes its own CPU/GPU memory. Keep 1 for the current 4 GB RTX 2050; raise
# this only after measuring memory and throughput on the deployment hardware.
# Valid range: 1-8. The backend schedules only bundles that load successfully.
OCR_MODEL_INSTANCES=1

# Number of auto-balloon jobs that may prepare/run in parallel. Paddle calls
# remain limited by the number of successfully loaded model instances. The
# deployment default is two workers with one model instance.
# Valid range: 1-32.
OCR_SCAN_WORKERS=2

# Auto-reload on code change (dev). Set 0 for production.
OCR_RELOAD=1

# CORS is intentionally unrestricted because client LAN hostnames, IP addresses,
# and ports are not known in advance. Authentication and CSRF remain enforced.

# ── Shared persistence (introduced in a later database milestone) ────────
# PostgreSQL or MSSQL connection string. Authentication uses this database;
# existing checksheet documents continue to use CHECKSHEET_DATA_DIR for now.
# DATABASE_URL=
# PostgreSQL (uses the BSD-licensed pg8000 driver):
# DATABASE_URL=postgresql+pg8000://qtracx_user:CHANGE_ME@db-server:5432/qtracx
# MSSQL (requires Microsoft ODBC Driver 18 installed on the backend host):
# DATABASE_URL=mssql+pyodbc://qtracx_user:CHANGE_ME@db-server:1433/qtracx?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Login sessions expire after this many hours (1-168). Cookie security follows
# the transport that actually starts: ordinary HTTP uses non-Secure cookies;
# successfully activated HTTPS uses Secure cookies.
AUTH_SESSION_HOURS=8

# ── Temporary customer demo window ──────────────────────────────────────────
# Leave disabled for normal installations. When enabled, every backend route
# except /health is locked after the configured window. A start time without
# an offset is interpreted as India Standard Time (UTC+05:30).
QTRACX_DEMO_LOCK_ENABLED=false
# QTRACX_DEMO_START_AT=2026-11-01T10:00:00
# Positive whole or decimal hours are accepted; e.g. 0.25 gives 15 minutes.
QTRACX_DEMO_DURATION_HOURS=48

CHECKSHEET_DATA_DIR=backend/data/checksheets
CHECKSHEET_MAX_DOCUMENT_MB=200

# ── CAD drawings ─────────────────────────────────────────────────────────
CAD_MAX_DOCUMENT_MB=128
CAD_CONVERT_TIMEOUT_SECONDS=180
# Optional explicit path to the ACadSharp-based DWG converter. DXF support
# does not require it. Relative paths are resolved from the repository root.
# DWG2DXF_ACADSHARP=tools/dwg2dxf/dist/win-x64/dwg2dxf-acadsharp.exe

# ── Diagnostic logging ───────────────────────────────────────────────────
QTRACX_LOG_DIR=backend/logs
QTRACX_LOG_LEVEL=INFO
QTRACX_LOG_MAX_MB=25
QTRACX_LOG_BACKUP_COUNT=10
# Human-readable scan reports are stored under QTRACX_LOG_DIR/runs/.
QTRACX_RUN_REPORT_KEEP=300

# Server-side debug dumps → backend/debug_output/
# DEBUG_DUMP=1          # dump every recognized box
# DEBUG_DUMP_FORCE=1    # re-dump even if a crop was saved before (.done)
